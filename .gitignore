# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Map payloads generated by scripts/precompute-map-cache.ts during `npm run build`.
/public/data/*.json

# SQLite journals. The canonical database is committed so Vercel can bundle it
# (lib/db/client.ts copies data/campus-universe.db into /tmp on cold start).
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# Local Apify LinkedIn lookup output. Produced on the owner's laptop.
/data/imports/apify_linkedin_results.jsonl
/data/imports/apify_linkedin_verify_results.jsonl
/data/imports/linkedin-free-checkpoint.json
/data/imports/linkedin-free-results.jsonl
/data/imports/linkedin-free.log
/data/imports/linkedin-direct-checkpoint.json
/data/imports/linkedin-direct-results.jsonl
/data/imports/linkedin-direct.log
