# Public pages run with none of these set. Pipeline and Shortlist stay locked
# until AUTH_SECRET and one free sign-in method are present.
# See README.md, "Sign-in for Pipeline and Shortlist".

# openssl rand -base64 32
AUTH_SECRET=

# Extra addresses besides any @dormroomfund.com email.
# These two are also the default when this variable is omitted.
ALLOWED_EMAILS=zhuanga@engineering.upenn.edu,amyzhuang880@gmail.com

# Optional From address. When unset and RESEND_API_KEY is set, mail is sent
# from Campus Scout <onboarding@resend.dev>.
EMAIL_FROM=

# Free magic-link sender: Resend when RESEND_API_KEY is set, otherwise Gmail SMTP
# (or Google sign-in below). /api/auth/health reports ok with AUTH_SECRET plus
# RESEND_API_KEY alone — SMTP_* is not required in that case. The health
# response lists missing variable names only, never values.

# Resend (preferred): https://resend.com — free tier, 3,000 emails/month, 100/day.
# Without a verified domain, mail only delivers to the Resend account email.
# Leave EMAIL_FROM unset so the app uses Campus Scout <onboarding@resend.dev>.
RESEND_API_KEY=

# Gmail SMTP fallback, used only when RESEND_API_KEY is unset.
# Free App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional free Google sign-in: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional donation destination; the Donate dialog explains availability until configured.
# NEXT_PUBLIC_SCOUT_SUPPORT_URL=https://buymeacoffee.com/YOUR_ACCOUNT

# Migration-only direct Postgres connection. Never expose with NEXT_PUBLIC_.
# Used only by npm run db:postgres:migrate -- ... --apply; does not change the app backend.
# CAMPUS_POSTGRES_MIGRATION_URL=postgresql://...
