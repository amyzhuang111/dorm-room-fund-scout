# Public pages run with none of these set. Pipeline and Shortlist stay locked
# until AUTH_SECRET and one free sign-in method are present.
# See README.md, "Sign-in for Pipeline and Shortlist".

# openssl rand -base64 32
AUTH_SECRET=

# Extra addresses besides any @dormroomfund.com email.
# These two are also the default when this variable is omitted.
ALLOWED_EMAILS=zhuanga@engineering.upenn.edu,amyzhuang880@gmail.com

# From address for the magic link.
EMAIL_FROM=

# Free magic-link sender: pick Resend OR Gmail SMTP (or Google sign-in below).

# Resend free tier: https://resend.com — 3,000 emails/month, 100/day.
# Without a verified domain, mail only delivers to the Resend account email
# and EMAIL_FROM should stay unset so the app uses onboarding@resend.dev.
RESEND_API_KEY=

# Gmail SMTP (free App Password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional free Google sign-in: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
